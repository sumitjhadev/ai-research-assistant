# Copy this file to .env and fill in your own values.
# NEVER commit your actual .env file — it is listed in .gitignore.

# Google Gemini API key (free tier, no credit card required).
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_key_here

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: URL the Streamlit frontend uses to reach the FastAPI backend.
# Defaults to http://localhost:8000 if unset.
BACKEND_URL=http://localhost:8000
